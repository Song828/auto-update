# TikTok 核心主站与 API
domain-rules /tiktok.com/ -nameserver ext -ipset ext -address #6
domain-rules /tik-tokapi.com/ -nameserver ext -ipset ext -address #6
domain-rules /tiktokv.com/ -nameserver ext -ipset ext -address #6
domain-rules /tiktokv.us/ -nameserver ext -ipset ext -address #6
domain-rules /tiktokw.us/ -nameserver ext -ipset ext -address #6
domain-rules /tiktokd.net/ -nameserver ext -ipset ext -address #6
domain-rules /tiktokd.org/ -nameserver ext -ipset ext -address #6
domain-rules /tiktokmusic.app/ -nameserver ext -ipset ext -address #6
domain-rules /musical.ly/ -nameserver ext -ipset ext -address #6

# TikTok CDN 视频及静态资源加载
domain-rules /tiktokcdn.com/ -nameserver ext -ipset ext -address #6
domain-rules /tiktokcdn-us.com/ -nameserver ext -ipset ext -address #6
domain-rules /tiktokcdn-eu.com/ -nameserver ext -ipset ext -address #6
domain-rules /tiktokcdn-in.com/ -nameserver ext -ipset ext -address #6
domain-rules /p16-tiktokcdn-com.akamaized.net/ -nameserver ext -ipset ext -address #6
domain-rules /muscdn.com/ -nameserver ext -ipset ext -address #6
domain-rules /ttwstatic.com/ -nameserver ext -ipset ext -address #6
domain-rules /ibytedtos.com/ -nameserver ext -ipset ext -address #6
domain-rules /ibyteimg.com/ -nameserver ext -ipset ext -address #6
domain-rules /ipstatp.com/ -nameserver ext -ipset ext -address #6
domain-rules /sgpstatp.com/ -nameserver ext -ipset ext -address #6

# TikTok 直播流（Live Streaming CDN）
domain-rules /ttlivecdn.com/ -nameserver ext -ipset ext -address #6
domain-rules /ttlivecdn.net/ -nameserver ext -ipset ext -address #6

# 字节跳动海外底层基础设施与加速骨干
domain-rules /byteoversea.com/ -nameserver ext -ipset ext -address #6
domain-rules /byteoversea.net/ -nameserver ext -ipset ext -address #6
domain-rules /byteintlapi.com/ -nameserver ext -ipset ext -address #6
domain-rules /bytefcdn.com/ -nameserver ext -ipset ext -address #6
domain-rules /bytefcdn-oversea.com/ -nameserver ext -ipset ext -address #6
domain-rules /bytefcdn-tt.com/ -nameserver ext -ipset ext -address #6
domain-rules /bytedapm.com/ -nameserver ext -ipset ext -address #6
domain-rules /bytegecko.com/ -nameserver ext -ipset ext -address #6
domain-rules /bytegecko-i18n.com/ -nameserver ext -ipset ext -address #6
domain-rules /lf16-effectcdn.byteeffecttos-g.com/ -nameserver ext -ipset ext -address #6
domain-rules /lf16-pkgcdn.pitaya-clientai.com/ -nameserver ext -ipset ext -address #6

# 常用组件与第三方依赖
domain-rules /snssdk.com/ -nameserver ext -ipset ext -address #6
domain-rules /isnssdk.com/ -nameserver ext -ipset ext -address #6
domain-rules /capcut.com/ -nameserver ext -ipset ext -address #6

# 屏蔽字节跳动 HTTPDNS（强制 App 使用系统 SmartDNS 解析）
domain-rules /httpdns.byteoversea.com/ -address #
domain-rules /httpdns.tiktokv.com/ -address #
domain-rules /bdturing.com/ -address #
